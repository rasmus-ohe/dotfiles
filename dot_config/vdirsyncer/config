[general]
status_path = "~/.local/share/vdirsyncer/status/"

[pair contacts]
a = "contacts_local"
b = "contacts_remote"
collections = ["from a", "from b"]
conflict_resolution = "b wins"

[storage contacts_local]
type = "filesystem"
path = "~/.local/share/contacts/"
fileext = ".vcf"

[storage contacts_remote]
type = "carddav"
url = "https://radicale.ratlabs.party"
username = "rasmus"
password.fetch = ["command", "pass", "show", "radicale/rasmus"]

[pair calendars]
a = "cal_local"
b = "cal_remote"
collections = ["from a", "from b"]
conflict_resolution = "b wins"

[storage cal_local]
type = "filesystem"
path = "~/.local/share/calendars/"
fileext = ".ics"

[storage cal_remote]
type = "caldav"
url = "https://radicale.ratlabs.party"
username = "rasmus"
password.fetch = ["command", "pass", "show", "radicale/rasmus"]
